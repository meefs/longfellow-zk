theorem rows_valid : rows.all Row.validBool = true := by native_decide

theorem rows_count : rows.length = 11 := by native_decide

/-- The certified flat openings for the same slice (`Grid.Comparison.flatResults`). -/
def flatOpenings : List ℕ := [122, 123, 124, 125, 126, 127, 128, 129, 131, 132, 133]

/-- **The graded bound costs at most two openings over flat**, and exactly one at every target
but the last.

This is the honest comparison, and it replaces an earlier claim of parity that was an artifact of
omitting `arithmeticProfile`.  The residual is a *double-counted probability-one term*: flat pays
`hyp(n-e-1)` once, inside the arithmetic term's cover at agreement zero, whereas this bound pays it
twice -- once as the proximity chain's clamp and once in the arithmetic term.  Sharing that
baseline, by grading on the **pair** of agreements rather than summing two separate contributions,
is the route to parity; see `../../../graded-rbr.tex`. -/
theorem graded_within_two_of_flat :
    (List.zipWith (fun row f => decide (row.openings ≤ f + 2)) rows flatOpenings).all id
      = true := by native_decide

theorem graded_within_one_of_flat_except_last :
    (List.zipWith (fun row f => decide (row.openings ≤ f + 1)) rows flatOpenings).count false
      = 1 := by native_decide


/-! ## The paired-level (parity) bound

`Row.bound` above charges the probability-one term **twice** -- once as the proximity chain's clamp
and once inside the arithmetic term's cover at agreement zero.  One state function on the *pair*
`(proximity agreement, arithmetic agreement)` charges it once, because the two failures are escaped
by the same query round: the verifier opens `r` columns once, and a query set that misses a proximity
disagreement is the same object as one that misses an arithmetic mismatch.  See
`../../../graded-rbr.tex` \S7 for the state function and why the pair is the coarsest level that
works.

The bound is then the single baseline plus the two tails, each restricted to the region where its
own coordinate is informative -- a profile whose labels are `0` below its threshold contributes
nothing there, which is how the restriction is written.
-/

namespace Row

/-- The proximity tail only: zero below the proximity radius, so the baseline is not re-charged. -/
def parityProxProfile (row : Row) : AgreementProfile row.n where
  labelsAtLeast agreement :=
    if agreement ≤ row.goodAgreementCap then 0
    else row.gradedCoefficient agreement * row.failureProfile.labelsAtLeast agreement

/-- The arithmetic tail only: zero below the response threshold. -/
def parityArithProfile (row : Row) : AgreementProfile row.n where
  labelsAtLeast agreement :=
    if agreement ≤ row.responseAgreementCap then 0 else row.listSize

/-- **The paired bound.**  One probability-one charge, then both tails.  The first summand is
`coverRatio n e g queries 0`, the query-round escape at the agreement the proximity radius
guarantees -- which is exactly the term the flat analysis pays once. -/
def parityBound (row : Row) (queries : ℕ) : ℚ :=
  hypergeometricRatio (max (row.n - row.e - 1) (min row.n row.g)) row.n queries +
    row.parityProxProfile.compressedContribution row.failureDenominator
      row.n row.n 0 queries +
    row.parityArithProfile.compressedContribution fieldSize row.n row.e row.g queries

def ParityValid (row : Row) : Prop :=
  row.ParametersValid ∧ 0 < row.openings ∧
    row.parityBound row.openings ≤ (1 : ℚ) / 2 ^ row.targetBits ∧
    (1 : ℚ) / 2 ^ row.targetBits < row.parityBound (row.openings - 1)

def parityValidBool (row : Row) : Bool :=
  @decide row.ParityValid (by unfold ParityValid ParametersValid; infer_instance)

end Row

