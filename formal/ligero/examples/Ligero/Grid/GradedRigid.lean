import examples.Ligero.Grid.Rigid
import Bcs.GradedFiatShamir

/-!
# Graded response-rigid grid

The numerical consequences of the *graded* accounting: `Bcs.GradedPair`'s clamped two-ascent
count, instantiated through `Bcs.GradedLigeroLayer`, with `escape` supplied by
`Bcs.GradedGrinding.toGradedPair`.

## What changes relative to `Grid.Rigid`

Two things, and they compose.

* **The clamp moves off the Johnson radius.**  `Grid.Rigid`'s `responseFloor` is
  `max (n-e-1) (sqrt (n (2k-1)))`: the probability-one baseline has to run all the way up to where
  the Johnson list bound becomes finite, because below that the listed-excess coefficient is
  vacuous.  The graded count has a second route at those levels -- charge the *pair* of ascents,
  which needs no fan-out bound at all and costs one work-normalised factor of `T` -- so the
  baseline stops at the proximity radius `n-e-1` instead.  That radius moves with `e`;
  `sqrt (n (2k-1))` is a function of `(n,k)` alone, which is why `Grid.Rigid`'s optimum was
  insensitive to the parameters.
* **Case B is gone.**  With `Q := H₂(x, root, alpha, response)` the query hash reads the batching
  challenge, so the second query cannot occupy the earlier slot: `Bcs.ChainedTrace.not_caseB`.

`gradedCoefficient` is the per-level minimum of the two routes.  `tupleListBoundAt = 0` marks the
regime where Johnson is vacuous (`Nat` division by a nonpositive denominator), and there the
unconditional pair coefficient `workBudget` is used.

## What this rests on

* the **work-normalised** convention (`../../../extractor-plan.md` §5.1): the bound below is the
  coefficient of the adversary's query budget, so `workBudget` appears as a multiplier on the
  profile mass rather than on the whole expression;
* **unit decoder fan-ins** -- `Bcs.GradedLigeroLayer.alphaFanin = queryFanin = 1`, i.e. a
  perfectly balanced digest decoder.  A biased sampler multiplies the corresponding budget;
* **the fan-out substitution, now proved.**  `gradedCoefficient` uses
  `min (tupleListBoundAt a) workBudget` above the floor, i.e. one factor of the adversary's query
  budget replaced by a list bound.  That is Target 6.1 of `../../../graded-rbr.tex`, and its
  two-round instance is `Bcs.pair_with_successors_card_le`, from which
  `Bcs.GradedGrinding.toGradedPair` discharges `Bcs.GradedPair.pair_card`.  The substitution is
  load-bearing -- with the coefficient `workBudget` at every level the expression ceilings at
  `workBudget / fieldSize = 2^-88` for **any** number of openings -- so it is worth saying what it
  now rests on: `Bcs.GradedGrinding.successors_card`, the statement that a level-`a` query point has
  at most `tupleListBoundAt a` level-`a` successors.  That is exactly where response rigidity plus
  the Johnson bound are spent, and it is a protocol obligation of the same kind as `chain` below,
  not a gap in the counting;
* both bad events being charged -- `gradedProfile` for proximity and `arithmeticProfile` for
  arithmetic soundness.  `Grid.Rigid` charges only the first, so its rows are **not** comparable to
  `Grid.Comparison.flatResults`;
* `Bcs.GradedGrinding.chain`, the verifier's recomputation, which is **not proved** -- the same
  outstanding obligation `Bcs.RigidAttribution` carries, tracked as Phase 3c in
  `../../../longfellow-nizk-plan.md` §3.  The fresh-hit term for a challenge the adversary never
  queried is likewise not included; at `1/|F|` per round it is below this expression's own field
  floor.

Generated by `ligero/examples/scripts/generate_graded_grid.py`.
-/

namespace Ligero.Examples.Grid.GradedRigid

open LigeroFamily

set_option maxHeartbeats 20000000

def fieldBits : ℕ := 128
def fieldSize : ℕ := 2 ^ fieldBits

/-- The adversary's random-oracle budget.  Enters as the pair route's coefficient. -/
def workBudget : ℕ := 2 ^ 40

/-- One searched protocol point.  `e`, `g` and `m` are free here, unlike `Grid.Rigid`'s rows,
because the graded optimum moves the radius. -/
structure Row where
  n : ℕ
  k : ℕ
  d : ℕ
  e : ℕ
  g : ℕ
  m : ℕ
  targetBits : ℕ
  openings : ℕ

namespace Row

def proximityAgreementCap (row : Row) : ℕ := row.k - 1
def responseAgreementCap (row : Row) : ℕ := 2 * row.k - 1

/-- The agreement the proximity radius guarantees: the baseline stops here. -/
def goodAgreementCap (row : Row) : ℕ := row.n - row.e - 1

def failureDenominator (row : Row) : ℕ := fieldSize - (row.g + 1)

def failureProfile (row : Row) : AgreementProfile row.n :=
  SchemeSelectedMCA.selectedMCAFailureProfile row.n row.g row.d
    (SelectedMCA.directLineFailureBound row.m)

/-- Product Johnson bound; `0` is the vacuous regime. -/
def tupleListBoundAt (row : Row) (agreement : ℕ) : ℕ :=
  Rigid.johnsonAgreementListBound row.n row.proximityAgreementCap agreement *
    Rigid.johnsonAgreementListBound row.n row.responseAgreementCap agreement *
    Rigid.johnsonAgreementListBound row.n row.responseAgreementCap agreement

/-- **The per-level minimum of the two routes.**  The listed route where rigidity plus Johnson
supply a finite fan-out, the pair route otherwise. -/
def gradedCoefficient (row : Row) (agreement : ℕ) : ℕ :=
  if row.tupleListBoundAt agreement = 0 then workBudget
  else min (row.tupleListBoundAt agreement) workBudget

/-- Baseline through the proximity radius, then the cheaper route. -/
def gradedProfile (row : Row) : AgreementProfile row.n where
  labelsAtLeast agreement :=
    if agreement ≤ row.goodAgreementCap then row.failureDenominator
    else row.gradedCoefficient agreement * row.failureProfile.labelsAtLeast agreement

/-- The interleaved-Johnson lift-list size at the decoding radius. -/
def listSize (row : Row) : ℕ :=
  CodingTheory.InterleavedJohnson.listBound row.n row.d (row.e + row.g)

/-- The work-normalised coefficient.  Chained, so there is no case-B term, but both bad events
are charged. -/
def bound (row : Row) (queries : ℕ) : ℚ :=
  row.gradedProfile.compressedContribution row.failureDenominator row.n row.n 0 queries +
    row.arithmeticProfile.compressedContribution fieldSize row.n row.e row.g queries

/-- The selected-MCA certificate, with `m` minimal for the displayed `g`.  The three
Johnson-radius conjuncts of `Grid.Rigid.Result.ParametersValid` are **absent**: the graded route
does not need a finite list bound at the floor. -/
def ParametersValid (row : Row) : Prop :=
  SelectedMCA.DirectCliqueCondition row.n row.e row.g row.d row.m ∧
    ¬SelectedMCA.DirectCliqueCondition row.n row.e row.g row.d (row.m - 1) ∧
    3 * row.g < row.d - row.e ∧
    row.g + 1 < fieldSize ∧
    0 < CodingTheory.InterleavedJohnson.denominator row.n row.d (row.e + row.g) ∧
    0 < row.k ∧ 2 * row.k ≤ row.n

def NumericValid (row : Row) : Prop :=
  row.ParametersValid ∧ 0 < row.openings ∧
    row.bound row.openings ≤ (1 : ℚ) / 2 ^ row.targetBits ∧
    (1 : ℚ) / 2 ^ row.targetBits < row.bound (row.openings - 1)

def validBool (row : Row) : Bool :=
  @decide row.NumericValid (by unfold NumericValid ParametersValid; infer_instance)

end Row

