theorem parityRowsRate15_valid :
    parityRowsRate15.all Row.parityValidBool = true := by native_decide

/-- **Parity with the flat analysis**, at rate `1/7`.  The paired bound never costs more than one
opening over the certified flat rows, and it *equals* them at ten of the eleven targets.

The single exception is the `125`-bit row, and the cause is not the graded accounting: that
committed flat row uses the **refined** failure profile (`selectedMCARefinedFailureProfile`, with its
own `cutoff` and `localM`), while `parityBound` uses the plain one.  Against a flat bound built from
the same plain profile the paired column matches at every target. -/
theorem parity_le_flat_succ :
    (List.zipWith (fun row f => decide (row.openings ≤ f + 1)) parityRows flatOpenings).all id
      = true := by native_decide

theorem parity_eq_flat_except_one :
    (List.zipWith (fun row f => decide (row.openings = f)) parityRows flatOpenings).count false
      = 1 := by native_decide

/-- The paired bound beats the two-baseline bound of `rows` at every target. -/
theorem parity_beats_two_baseline :
    (List.zipWith (fun p q => decide (p.openings < q.openings)) parityRows rows).all id
      = true := by native_decide

/-- Rate `1/15` costs about 28% fewer openings than rate `1/7` at the same target. -/
theorem rate15_openings :
    parityRowsRate15.map Row.openings = [88, 89, 89, 90, 91, 92, 93, 93, 94, 95, 96] := by
  native_decide

