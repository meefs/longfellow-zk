import CodingTheory.Basic
import Mathlib.Tactic.Ring

/-!
# Basic affine-agreement definitions

This module contains the small, stable vocabulary shared by correlated
agreement and selected MCA. It has no dependency on either proof engine.
-/

namespace AffineAgreement

export CodingTheory
  (Word LinearCode supportOn mem_supportOn supportOn_subset weight
    agreementCoordinates mem_agreementCoordinates jointSupport
    HasMinimumDistanceAtLeast supportOn_add_subset supportOn_add_card_le
    weight_add_le supportOn_smul_subset supportOn_smul_card_le weight_smul_le
    supportOn_neg weight_neg weight_le_supportOn_add_complement)

variable {F : Type*} [Field F] [DecidableEq F]

/-- The affine word line generated by `x` and `y`. -/
def affineWord {n : ℕ} (x y : Word F n) (a : F) : Word F n :=
  fun i ↦ x i + a * y i

omit [DecidableEq F] in
@[simp] theorem affineWord_apply {n : ℕ} (x y : Word F n) (a : F)
    (i : Fin n) : affineWord x y a i = x i + a * y i := rfl

omit [DecidableEq F] in
/-- Subtraction commutes with forming an affine word. -/
theorem affineWord_sub {n : ℕ} (u v p₀ p₁ : Word F n) (a : F) :
    affineWord (u - p₀) (v - p₁) a =
      affineWord u v a - affineWord p₀ p₁ a := by
  funext i
  simp [affineWord]
  ring

end AffineAgreement
